   "recording": "IOxzFrNmLJY",
   "gradeResolution": {
    "key": "makris-scherzo-four-violins",
    "status": "approved",
    "level": 6,
    "consideredOpinions": [
     7,
     6,
     8
    ],
    "confidence": "medium",
    "hardestPart": "violin 1",
    "basis": "The engraved Violin I part (source42-103548.pdf pp.1-3) is in treble clef and sits high above the staff for long stretches, with a rest-filled 3/8 scherzo: bars of slurred repeated 16ths in the opening (p.1), long sustained high notes with a dotted tremolo-like marking (p.2, ledger lines above the staff), and about 40 bars of one slurred 16th-note cell repeated on the top of the E string, ending on sustained very high notes (p.3). The ff and fff dynamics and high-position security are real, but the figure is mechanical and repeated, not varied virtuoso passagework, so the 'extreme' wording of the level-8 opinion is overstated and the repeated-cell endurance does not reach the Bacewicz anchor at 7. The handwritten score (source42-103546.pdf pp.1-2) shows the lower parts on ostinato repeated 16ths and displaced entries on rests, with no clear ensemble demand beyond the notes, so no uplift. Six is the best fit; the level-6 opinion's reading of the notation held up, the level-8 and level-7 readings overrated the repetition.",
    "sources": [
     "https://imslp.org/wiki/Scherzo_for_Four_Violins_(Makris,_Andreas)"
    ],
    "adjudicationFile": "data/chamber/same-instrument/reviews/final21-adjudications-normalized.json"
   }
