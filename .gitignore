# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data caches
/data/cache/
/data/chamber/same-instrument/staging/
/data/chamber/same-instrument/scratch/
/data/chamber/same-instrument/evidence/
/data/chamber/same-instrument/cello_enrichment/
/data/chamber/same-instrument/**/*.pyc
/data/chamber/same-instrument/**/*.pdf
/data/chamber/same-instrument/**/*.png
/data/chamber/same-instrument/**/*.jpg
/scratch/grades-04/
/design/*.png

# local tooling
/.claude/

# catalogue expansion: derived or bulky outputs (regenerate with scripts/expand/)
/data/expansion/preview/
/data/expansion/sheet-sync/
/data/expansion/final/all-repertoire.next.json

# Python bytecode from scripts/expand/*.py
__pycache__/
/data/expansion/tech/final/all-repertoire.*.json
/data/expansion/tech/final/keys.json
/data/expansion/tech/to-grade.json
/data/expansion/tech/catalogue-compact.txt

# chamber curation: per-slice agent inputs (regenerate with npx tsx scripts/chamber/curation_slices.ts --inputs)
/data/chamber/curation/input/
# chamber recordings: the judges' inputs, built from the git-ignored YouTube cache (npx tsx scripts/chamber/recordings.ts export)
/data/chamber/recordings/to-judge/
